{
  "name": "@dxtintx/sout4js",
  "version": "3.0.0",
  "description": "Fast, lightweight, and versatile logger for Node.js and the Web with colored output, file logging, and TypeScript support.",
  "main": "node/node.js",
  "module": "src/index.mjs",
  "browser": "web/web.js",
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./node/node.js"
    },
    "./node": {
      "types": "./types.d.ts",
      "import": "./node/node.mjs",
      "require": "./node/node.js"
    },
    "./web": {
      "types": "./types.d.ts",
      "import": "./web/web.mjs",
      "require": "./web/web.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "node",
    "web",
    "src",
    "types.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node test.js"
  },
  "keywords": [
    "logger",
    "logging",
    "console",
    "terminal",
    "colors",
    "sout",
    "sout4js",
    "browser",
    "node",
    "typescript"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotinto/sout4js.git"
  },
  "author": "dxtintx",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/dotinto/sout4js/issues"
  },
  "homepage": "https://github.com/dotinto/sout4js#readme"
}